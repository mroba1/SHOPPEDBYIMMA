# ── Vercel (frontend) ─ copy to .env.local for local dev ──
ADMIN_PASSWORD=imma-admin
ADMIN_SECRET=replace-with-a-long-random-string
# Leave API_URL empty locally to use data/db.json. On Vercel, set it to your Render URL.
API_URL=
API_SECRET=

# ── Render (backend) ─ set in the Render dashboard / render.yaml ──
# API_SECRET=same-value-as-vercel
# DATA_DIR=/var/data
