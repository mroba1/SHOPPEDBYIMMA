# ─────────────────────────────────────────────────────────────
# VERCEL (frontend). Also copy to .env.local for local dev.
# ─────────────────────────────────────────────────────────────

# Private admin login address: https://your-site.com/<ADMIN_PATH>
# Pick something unguessable. It's a convenience, not the security.
ADMIN_PATH=manage-shoppedbyimma

# Signs login cookies. REQUIRED in production (32+ random characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Leave empty to run everything on this server (local dev / Vercel preview).
# With a Render backend: its URL, and the same API_SECRET as on Render.
API_URL=
API_SECRET=

# ─────────────────────────────────────────────────────────────
# WHERE THE DATA LIVES (Render in production; this server when
# API_URL is empty). The first admin is created from these.
# In local dev they default to admin@shoppedbyimma.com / imma-admin.
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Imma
# Enables "Forgot password?" on the admin login
ADMIN_RECOVERY_KEY=
# DATA_DIR=/var/data
